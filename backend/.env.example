# Porta HTTP da API
PORT=3000
# Base de dados:
#   memory://              PostgreSQL embutido em memória (testes)
#   pglite://./.data/muntu PostgreSQL embutido gravado em disco (desenvolvimento)
#   postgres://utilizador:senha@host:5432/muntu  PostgreSQL real (produção)
DATABASE_URL=pglite://./.data/muntu
# Segredos (em produção: 32+ caracteres aleatórios, nunca no repositório)
JWT_SECRET=troque-isto-por-um-segredo-com-32-caracteres
QR_SECRET=troque-isto-por-outro-segredo-com-32-caracteres
WEBHOOK_SECRET=segredo-partilhado-com-o-agregador-de-pagamentos
# Lembretes automáticos e envio de SMS/notificações dentro da API.
# Com várias instâncias, ligar só numa (os envios são idempotentes de qualquer forma).
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=30
# Fornecedor de SMS/WhatsApp: "registo" só escreve no log (desenvolvimento)
MESSAGE_PROVIDER=registo
